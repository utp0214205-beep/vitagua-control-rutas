# Copia este archivo como .env y configura tus valores locales.
# No subas el archivo .env real a Git.

PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

PGHOST=localhost
PGPORT=5432
PGDATABASE=vitagua_rutas
PGUSER=postgres
PGPASSWORD=cambia_esta_contrasena
# Usa "true" solo si tu proveedor de PostgreSQL requiere SSL.
PGSSL=false

# Clave privada para firmar tokens JWT (mínimo 32 caracteres; no reutilices contraseñas).
JWT_SECRET=reemplaza_esto_por_una_clave_aleatoria_larga_y_privada
JWT_EXPIRES_IN=8h
